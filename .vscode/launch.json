{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "gate",
            "type": "go",
            "request": "launch",
            "mode": "exec",
            "program": "${workspaceFolder}/debug_bin.exe",
            "cwd": "${workspaceFolder}",
            "args": [
                "-conf",
                "./config/gate_1.yaml"
            ]
        },
        {
            "name": "login",
            "type": "go",
            "request": "launch",
            "mode": "exec",
            "program": "${workspaceFolder}/debug_bin.exe",
            "cwd": "${workspaceFolder}",
            "args": [
                "-conf",
                "./config/login_11.yaml"
            ]
            // 没有 preLaunchTask
        },
        {
            "name": "game1",
            "type": "go",
            "request": "launch",
            "mode": "exec",
            "program": "${workspaceFolder}/debug_bin.exe",
            "cwd": "${workspaceFolder}",
            "args": [
                "-conf",
                "./config/game_101.yaml"
            ]
        }
    ],
    "compounds": [
        {
            "name": "servers",
            "configurations": [
                "gate",
                "login",
                "game1"
            ],
            "preLaunchTask": "build" // 复合启动前统一编译一次
        }
    ]
}